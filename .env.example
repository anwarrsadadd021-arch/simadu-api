# Salin file ini menjadi .env lalu sesuaikan nilainya. Jangan commit file .env.

# Port server
PORT=3000

# Kunci penandatangan token (WAJIB, minimal 32 karakter).
# Nilai di bawah hanya untuk pengembangan lokal. Buat nilai acak sendiri dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Masa berlaku token (contoh: 15m, 1h)
JWT_EXPIRES_IN=15m

# Biaya hashing bcrypt (semakin besar semakin lambat dan aman)
BCRYPT_ROUNDS=10

# Batas percobaan login per IP dalam 15 menit
LOGIN_RATE_LIMIT_MAX=10
