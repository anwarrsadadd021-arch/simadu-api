{
  "openapi": "3.0.3",
  "info": {
    "title": "SIMADU API",
    "version": "1.0.0",
    "description": "REST API Sistem Layanan Informasi dan Pengaduan Mahasiswa (UTS Web Service Engineering).\n\n**Cara memakai di Swagger UI:** panggil `POST /api/auth/login`, salin nilai `data.token`, klik tombol **Authorize**, lalu tempel token (tanpa kata \"Bearer\").\n\n**Akun uji:** `budi` / `Budi#2026` (mahasiswa), `siti` / `Siti#2026` (mahasiswa), `admin` / `Admin#2026` (administrator).\n\n**Aturan akses:** mahasiswa hanya mengelola pengaduannya sendiri (ubah/hapus hanya saat status `diajukan`); administrator melihat semua pengaduan dan memperbarui status."
  },
  "servers": [
    {
      "url": "/",
      "description": "Server saat ini"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autentikasi pengguna"
    },
    {
      "name": "Pengaduan",
      "description": "Pengelolaan pengaduan mahasiswa"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login dan dapatkan Bearer token",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "budi",
                "password": "Budi#2026"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Kredensial salah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Username atau password salah"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/pengaduan": {
      "get": {
        "tags": [
          "Pengaduan"
        ],
        "summary": "Daftar pengaduan sesuai hak akses",
        "operationId": "listPengaduan",
        "description": "Mahasiswa hanya menerima pengaduan miliknya; administrator menerima seluruh pengaduan.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Status"
            }
          },
          {
            "name": "kategori",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Kategori"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PengaduanListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Pengaduan"
        ],
        "summary": "Membuat pengaduan (mahasiswa)",
        "operationId": "createPengaduan",
        "description": "Hanya mahasiswa. `id`, `mahasiswaId`, `status`, dan `createdAt` ditentukan server; mengirimkannya akan ditolak (400).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PengaduanInput"
              },
              "example": {
                "judul": "AC ruang kelas C101 mati",
                "kategori": "Fasilitas",
                "deskripsi": "AC di ruang C101 tidak dingin sehingga ruangan terasa sangat panas."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pengaduan dibuat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PengaduanResponse"
                },
                "example": {
                  "success": true,
                  "message": "Pengaduan berhasil dibuat",
                  "data": {
                    "id": 4,
                    "mahasiswaId": "M2024001",
                    "judul": "AC ruang kelas C101 mati",
                    "kategori": "Fasilitas",
                    "deskripsi": "AC di ruang C101 tidak dingin sehingga ruangan terasa sangat panas.",
                    "status": "diajukan",
                    "createdAt": "2026-11-23T02:10:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/pengaduan/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "ID pengaduan (bilangan bulat positif)",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          }
        }
      ],
      "get": {
        "tags": [
          "Pengaduan"
        ],
        "summary": "Detail pengaduan",
        "operationId": "getPengaduan",
        "description": "Mahasiswa hanya boleh melihat pengaduan miliknya (selain itu 403); administrator boleh melihat semua.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PengaduanResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Pengaduan"
        ],
        "summary": "Mengubah judul, kategori, deskripsi (mahasiswa pemilik)",
        "operationId": "updatePengaduan",
        "description": "Hanya mahasiswa pemilik dan hanya saat status `diajukan`. Admin ditolak (403). Status selain `diajukan` -> 409.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PengaduanInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil diubah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PengaduanResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Pengaduan"
        ],
        "summary": "Menghapus pengaduan (mahasiswa pemilik)",
        "operationId": "deletePengaduan",
        "description": "Hanya mahasiswa pemilik dan hanya saat status `diajukan`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil dihapus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "success": true,
                  "message": "Pengaduan berhasil dihapus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/pengaduan/{id}/status": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "ID pengaduan (bilangan bulat positif)",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          }
        }
      ],
      "patch": {
        "tags": [
          "Pengaduan"
        ],
        "summary": "Memperbarui status penanganan (administrator)",
        "operationId": "updateStatusPengaduan",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusInput"
              },
              "example": {
                "status": "diproses"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status diperbarui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PengaduanResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token dari POST /api/auth/login"
      }
    },
    "schemas": {
      "Kategori": {
        "type": "string",
        "enum": [
          "Fasilitas",
          "Akademik",
          "TI"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "diajukan",
          "diproses",
          "selesai"
        ]
      },
      "Pengaduan": {
        "type": "object",
        "required": [
          "id",
          "mahasiswaId",
          "judul",
          "kategori",
          "deskripsi",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 4
          },
          "mahasiswaId": {
            "type": "string",
            "example": "M2024001"
          },
          "judul": {
            "type": "string",
            "example": "AC ruang kelas C101 mati"
          },
          "kategori": {
            "$ref": "#/components/schemas/Kategori"
          },
          "deskripsi": {
            "type": "string",
            "example": "AC di ruang C101 tidak dingin sehingga ruangan terasa sangat panas."
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-23T02:10:00.000Z"
          }
        }
      },
      "PengaduanInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judul",
          "kategori",
          "deskripsi"
        ],
        "properties": {
          "judul": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "kategori": {
            "$ref": "#/components/schemas/Kategori"
          },
          "deskripsi": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          }
        }
      },
      "StatusInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "budi"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Budi#2026"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Login berhasil"
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              },
              "tokenType": {
                "type": "string",
                "example": "Bearer"
              },
              "expiresIn": {
                "type": "string",
                "example": "15m"
              },
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "example": "M2024001"
                  },
                  "nama": {
                    "type": "string",
                    "example": "Budi Santoso"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "mahasiswa",
                      "admin"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "PengaduanResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Pengaduan"
          }
        }
      },
      "PengaduanListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pengaduan"
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "description": "Rincian per field (hanya untuk 400)",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Input tidak valid (field wajib kosong, field tidak diperbolehkan, tipe/format salah, JSON rusak)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Validasi gagal",
              "errors": [
                {
                  "field": "judul",
                  "message": "Field tidak boleh kosong"
                }
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Token tidak ada, tidak valid, atau kedaluwarsa",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Autentikasi diperlukan: sertakan header Authorization Bearer"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Terautentikasi tetapi tidak berhak (role atau kepemilikan)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Anda tidak berhak mengakses pengaduan ini"
            }
          }
        }
      },
      "NotFound": {
        "description": "Sumber daya tidak ditemukan",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Pengaduan tidak ditemukan"
            }
          }
        }
      },
      "Conflict": {
        "description": "Operasi bertentangan dengan keadaan data (pengaduan tidak lagi berstatus diajukan)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Pengaduan hanya dapat diubah atau dihapus selama berstatus diajukan"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Terlalu banyak percobaan login",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Terlalu banyak percobaan login, coba lagi nanti"
            }
          }
        }
      },
      "ServerError": {
        "description": "Kesalahan server (detail internal tidak dibocorkan)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Terjadi kesalahan pada server"
            }
          }
        }
      }
    }
  }
}
